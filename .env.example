# คัดลอกเป็น .env แล้วใส่ค่าจริง — ห้าม commit ไฟล์ .env
# ค่าจริงของ production ให้เก็บใน secret manager / ตัวแปรของ server ไม่ใช่ในไฟล์เดียวกับค่า development

# --- Database (ใช้ user เฉพาะแอป ไม่ใช่ root) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=stneoc_app
DB_PASSWORD=change-me
# DB_TIMEZONE = time zone ที่ใช้ทั้งฝั่ง MySQL และแอป (ค่าเริ่มต้น +07:00 เวลาไทย)
DB_TIMEZONE=+07:00
DB_NAME=stneoc
DB_POOL_LIMIT=10

# --- Security ---
# กุญแจสำหรับ HMAC ของเลขบัตรประชาชนและเข้ารหัส cookie ประชาชน (สุ่มยาว ≥ 32 ตัวอักษร)
SECRET_KEY=
# จำนวนชั้นของ reverse proxy ที่เชื่อถือได้ (nginx 1 ชั้น = 1) ถ้าไม่ได้อยู่หลัง proxy ให้เว้นว่าง
TRUST_PROXY=1
# นาทีที่ไม่มีการใช้งานก่อน session หมดอายุ (5–240, ค่าเริ่มต้น 10)
SESSION_IDLE_MINUTES=10
# กุญแจเข้ารหัสไฟล์ backup (≥ 16 ตัวอักษร) — เก็บแยกจาก backup
BACKUP_ENCRYPTION_KEY=

# --- Application URL ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000/stn-eoc
NEXT_PUBLIC_API_URL=http://localhost:3000/stn-eoc
UPLOAD_DIR=
# รูปจากประชาชน (ไม่เปิดตรงจาก public) — ค่าเริ่มต้น ./private/uploads
PRIVATE_UPLOAD_DIR=

# --- ThaiD (DOPA) ---
THAIID_CALLBACK_URL=http://localhost:3000/stn-eoc/api/auth/thaiid/callback
THAIID_CLIENT_ID=
THAIID_CLIENT_SECRET=
THAIID_API_KEY=
THAIID_SCOPE=pid given_name family_name

# --- External services ---
GISTDA_API_KEY=
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_HELP_NOTIFY_CHAT_IDS=
TELEGRAM_SECURITY_CHAT_IDS=

# แจ้งเตือนอัตโนมัติของเหตุการณ์ (ส่งไป TELEGRAM_HELP_NOTIFY_CHAT_IDS)
# ALERT_CRON_SECRET = ใช้กับตัวตั้งเวลาเรียก POST /stn-eoc/api/eoc/alerts?eoc=flood (header x-cron-secret)
ALERT_CRON_SECRET=
# EOC_ALERTS_TELEGRAM=off = ปิดการส่ง Telegram ชั่วคราว (ช่วงทดสอบ/ซ้อมแผน) ระบบยังบันทึกประวัติแจ้งเตือน
EOC_ALERTS_TELEGRAM=on
# ลิงก์ในข้อความแจ้งเตือน เช่น https://eoc.example.go.th
NEXT_PUBLIC_APP_URL=

# ระดับน้ำ/ตลิ่งบนแผนที่สภาพอากาศ (คลังข้อมูลน้ำแห่งชาติ ThaiWater) — เซิร์ฟเวอร์ต้องออกเน็ตไป api-v3.thaiwater.net ได้
# THAIWATER_WATERLEVEL_URL=https://api-v3.thaiwater.net/api/v1/thaiwater30/public/waterlevel?province_code=91

# แจ้งเตือนระดับน้ำล้นตลิ่ง (ตรวจอัตโนมัติในเซิร์ฟเวอร์ production — ส่ง Telegram กลุ่มเดียวกับ TELEGRAM_HELP_NOTIFY_CHAT_IDS)
# WATER_ALERT_NEAR_M=0.5            # น้ำห่างตลิ่งไม่เกินกี่เมตร ถือว่า "ใกล้ล้นตลิ่ง"
# WATER_ALERTS_INTERVAL_MIN=10      # รอบตรวจ 5–60 นาที, off = ปิด
# WATER_ALERTS_SCHEDULER=on         # บังคับเปิดตัวตรวจอัตโนมัติตอน npm run dev (ปกติเปิดเฉพาะ production)
# RAIN_ALERT_WATCH_MM=60            # ฝน 24 ชม. ต่อสถานี ถึงเกณฑ์นี้แจ้ง "ฝนหนัก"
# RAIN_ALERT_SEVERE_MM=90.1         # ถึงเกณฑ์นี้แจ้ง "ฝนหนักมาก" (เกณฑ์กรมอุตุฯ)
# THAIWATER_RAIN_URL=https://api-v3.thaiwater.net/api/v1/thaiwater30/public/rain_24h?province_code=91
